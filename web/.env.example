NEXT_PUBLIC_COURT4_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_COURT4_MAX_UPLOAD_BYTES=1073741824
NEXT_PUBLIC_COURT4_SUPPORTED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv

# Server-only auth proxy configuration. Required in production; use HTTPS origins.
# Keep NEXT_PUBLIC_COURT4_API_URL pointed at the API for non-auth requests.
COURT4_AUTH_PROXY_UPSTREAM=http://127.0.0.1:8000
COURT4_WEB_ORIGIN=http://localhost:3000
